/*
 * DSView dark palette, modelled on VS Code "Dark Modern".
 * Used by theme.qss as @name.
 * Format: @name: value;   (value may reference another @name)
 */

/* backgrounds, from back to front */
@chrome:         #181818;   /* title bar, toolbar, panel headers (VS Code side bar) */
@bg:             #1f1f1f;   /* window, waveform area (VS Code editor) */
@surface:        #313131;   /* inputs, buttons */
@hover:          #3a3d3e;   /* hover fill, inner dividers */
@divider:        #2b2b2b;   /* lines between title bar / toolbar / panels */
@border:         #3c3c3c;   /* input / button borders */
@handle:         #4a4a4a;   /* scrollbar handles, strong lines */
@border-hover:   #5a5a5a;   /* input border on hover */

/* text */
@text:           #cccccc;
@text-bright:    #ffffff;   /* selected / highlighted text */
@text-muted:     #9d9d9d;   /* secondary labels, headers */
@text-disabled:  #6e6e6e;

/* accent */
@accent:         #0078d4;
@accent-hover:   #026ec1;
@accent-pressed: #005ba4;
@on-accent:      #ffffff;   /* text on accent background */
@selection:      #04395e;   /* selected rows, menu items */

/* status */
@danger:         #f14c4c;
@danger-hover:   #f36d6d;
@close-hover:    #e81123;   /* window close button */

/* icon set used in url(...) */
@icons:          :/dark;
