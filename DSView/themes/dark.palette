/*
 * DSView dark palette. Used by theme.qss as @name.
 * Format: @name: value;   (value may reference another @name)
 */

/* backgrounds, from back to front */
@bg:             #1e1f22;   /* window, waveform area */
@surface:        #2b2d30;   /* inputs, panels, dock titles */
@hover:          #393b40;   /* hover fill, dividers */
@border:         #43454a;   /* input / button borders */
@handle:         #4e5157;   /* scrollbar handles, strong lines */
@border-hover:   #5a5d63;   /* input border on hover */

/* text */
@text:           #dfe1e5;
@text-bright:    #ffffff;   /* selected / highlighted text */
@text-muted:     #9da0a8;   /* secondary labels, headers */
@text-disabled:  #6f737a;

/* accent */
@accent:         #3574f0;
@accent-hover:   #4a83f5;
@accent-pressed: #2f66d6;
@on-accent:      #ffffff;   /* text on accent background */
@selection:      #2e436e;   /* selected rows, menu items */

/* status */
@danger:         #c94f4f;
@danger-hover:   #e06c6c;

/* icon set used in url(...) */
@icons:          :/dark;
