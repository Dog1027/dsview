/*
 *  DSView stylesheet template.
 *
 *  Colors are written as @name tokens and are filled in from the palette
 *  of the active theme: dark.palette / light.palette (same directory).
 *  @icons expands to the theme's icon directory (:/dark or :/light).
 *
 *  Live editing: start DSView with DSVIEW_THEME_DIR=<repo>/DSView/themes
 *  and every save of this file or a palette is applied immediately.
 * ---------------------------------------------------------------------
