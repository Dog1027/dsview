 */

QToolTip
{
    border: 1px solid @border;
    border-radius: 4px;
    background-color: @surface;
    alternate-background-color: @hover;
    color: @text;
    padding: 4px 8px;
    opacity: 240;
}

QWidget
{
    color: @text;
    background-color: @bg;
    selection-background-color:@accent;
    selection-color: @text;
    background-clip: border;
    image: none;
    border: 0px transparent;
    outline: 0;
}

/*
QWidget:item:hover
{
    background-color: @accent;
    color: @text;
}

QWidget:item:selected
{
    background-color: @accent;
}
*/

QPushButton#flat{
    text-align:left;
    border:none;
}

QPushButton#flat:hover
{
    background-color: @hover;
    color: @text;
}

QCheckBox
{
    spacing: 8px;
    outline: none;
    color: @text;
    margin-bottom: 2px;
    opacity: 200;
}

QCheckBox:disabled
{
    color: @text-disabled;
}

QGroupBox::indicator
{
    width: 18px;
    height: 18px;
    margin-left: 2px;
}

QCheckBox::indicator:unchecked,
QCheckBox::indicator:unchecked:focus
{
    image: url(@icons/checkbox_unchecked.svg);
}

QCheckBox::indicator:unchecked:hover,
QCheckBox::indicator:unchecked:pressed,
QGroupBox::indicator:unchecked:hover,
QGroupBox::indicator:unchecked:focus,
QGroupBox::indicator:unchecked:pressed
{
    border: none;
    image: url(@icons/checkbox_unchecked-hover.svg);
}

QCheckBox::indicator:checked
{
    image: url(@icons/checkbox_checked.svg);
}

QCheckBox::indicator:checked:hover,
QCheckBox::indicator:checked:focus,
QCheckBox::indicator:checked:pressed,
QGroupBox::indicator:checked:hover,
QGroupBox::indicator:checked:focus,
QGroupBox::indicator:checked:pressed
{
    border: none;
    image: url(@icons/checkbox_checked-hover.svg);
}

QCheckBox::indicator:indeterminate
{
    image: url(@icons/checkbox_indeterminate.svg);
}

QCheckBox::indicator:indeterminate:focus,
QCheckBox::indicator:indeterminate:hover
QCheckBox::indicator:indeterminate:pressed
{
    image: url(@icons/checkbox_indeterminate-hover.svg);
}

QCheckBox::indicator:indeterminate:disabled
{
    image: url(@icons/checkbox_indeterminate_disabled.svg);
}

QCheckBox::indicator:checked:disabled,
QGroupBox::indicator:checked:disabled
{
    image: url(@icons/checkbox_checked_disabled.svg);
}

QCheckBox::indicator:unchecked:disabled,
QGroupBox::indicator:unchecked:disabled
{
    image: url(@icons/checkbox_unchecked_disabled.svg);
}

QRadioButton
{
    spacing: 8px;
    outline: none;
    color: @text;
    margin-bottom: 2px;
}

QRadioButton:disabled
{
    color: @text-disabled;
}
QRadioButton::indicator
{
    width: 10px;
    height: 10px;
}

QRadioButton::indicator:unchecked,
QRadioButton::indicator:unchecked:focus
{
    image: url(@icons/radio_unchecked.svg);
}


QRadioButton::indicator:unchecked:hover,
QRadioButton::indicator:unchecked:pressed
{
    border: none;
    outline: none;
    image: url(@icons/radio_unchecked-hover.svg);
}


QRadioButton::indicator:checked
{
    border: none;
    outline: none;
    image: url(@icons/radio_checked.svg);
}

QRadioButton::indicator:checked:hover,
QRadioButton::indicator:checked:focus,
QRadioButton::indicator:checked:pressed
{
    border: none;
    outline: none;
    image: url(@icons/radio_checked-hover.svg);
}

QRadioButton::indicator:checked:disabled
{
    outline: none;
    image: url(@icons/radio_checked_disabled.svg);
}

QRadioButton::indicator:unchecked:disabled
{
    image: url(@icons/radio_unchecked_disabled.svg);
}

QMenuBar
{
    background-color: @bg;
    color: @text;
}

QMenuBar::item
{
    background: transparent;
}

QMenuBar::item:selected
{
    background: transparent;
    border: 1px transparent;
}

QMenuBar::item:pressed
{
    border: 1px transparent;
    border-radius: 4px;
    background-color: @hover;
    color: @text;
}

QMenu
{
    background-color: @bg;
    border: 1px solid @border;
    border-radius: 8px;
    color: @text;
    margin: 0px;
    padding: 5px;
}

QMenu::item
{
    padding: 6px 28px 6px 6px;
    margin: 0px;
    border: none;
    border-radius: 5px;
    background-color: transparent;
}

QMenu::icon
{
    padding-left: 8px;
}

QMenu::item:selected
{
    background-color: @accent;
    color: @on-accent;
}

QMenu::item:disabled
{
    color: @text-disabled;
}

QMenu::separator
{
    height: 1px;
    background: @border;
    margin: 4px 8px;
}

QMenu::indicator {
    width: 18px;
    height: 18px;
}

/* non-exclusive indicator = check box style indicator
   (see QActionGroup::setExclusive) */
QMenu::indicator:non-exclusive:unchecked
{
    image: url(@icons/checkbox_unchecked_disabled.svg);
}

QMenu::indicator:non-exclusive:unchecked:selected
{
    image: url(@icons/checkbox_unchecked_disabled.svg);
}

QMenu::indicator:non-exclusive:checked
{
    image: url(@icons/checkbox_checked.svg);
}

QMenu::indicator:non-exclusive:checked:selected
{
    image: url(@icons/checkbox_checked.svg);
}

/* exclusive indicator = radio button style indicator (see QActionGroup::setExclusive) */
QMenu::indicator:exclusive:unchecked
{
    image: url(@icons/radio_unchecked_disabled.svg);
}

QMenu::indicator:exclusive:unchecked:selected
{
    image: url(@icons/radio_unchecked_disabled.svg);
}

QMenu::indicator:exclusive:checked
{
    image: url(@icons/radio_checked.svg);
}

QMenu::indicator:exclusive:checked:selected
{
    image: url(@icons/radio_checked.svg);
}

QMenu::right-arrow
{
    margin: 5px;
    image: url(@icons/right_arrow.svg);
}


QWidget:disabled
{
    color: @text-disabled;
    background-color: @bg;
}

QAbstractItemView
{
    alternate-background-color: @border;
    color: @text;
    border: 1px transparent;
    border-radius: 2px;
    padding: 1px
}

QTabWidget:focus,
QCheckBox:focus,
QRadioButton:focus,
QSlider:focus
{
    border: none;
}

QLineEdit
{
    background-color: @surface;
    padding: 3px 6px;
    border-style: solid;
    border: 1px solid @border;
    border-radius: 4px;
    color: @text;
    selection-background-color: @selection;
}

QTextEdit
{
    background-color: @surface;
    padding: 3px 6px;
    border-style: solid;
    border: 1px solid @border;
    border-radius: 4px;
    color: @text;
}

/* Group: title above a rounded frame (the title does not cut the line). */
QGroupBox
{
    border: 1px solid @border;
    border-radius: 8px;
    margin-top: 1.7em;
    padding-top: 2px;
}

QGroupBox::title
{
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 2px;
    padding: 0px;
    font-weight: 600;
}

QScrollBar:horizontal
{
    height: 12px;
    margin: 2px 12px 2px 12px;
    border: 1px transparent;
    border-radius: 4px;
    background-color: transparent;
}

QScrollBar::handle:horizontal
{
    background-color: @handle;
    min-width: 24px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover,
QScrollBar::handle:vertical:hover
{
    background-color: @text-disabled;
}

QScrollBar::add-line:horizontal
{
    margin: 0px 3px 0px 3px;
    image: url(@icons/right_arrow_disabled.svg);
    width: 10px;
    height: 10px;
    subcontrol-position: right;
    subcontrol-origin: margin;
}

QScrollBar::sub-line:horizontal
{
    margin: 0px 3px 0px 3px;
    image: url(@icons/left_arrow_disabled.svg);
    width: 10px;
    height: 10px;
    subcontrol-position: left;
    subcontrol-origin: margin;
}

QScrollBar::add-line:horizontal:hover,
QScrollBar::add-line:horizontal:on
{
    image: url(@icons/right_arrow.svg);
    width: 10px;
    height: 10px;
    subcontrol-position: right;
    subcontrol-origin: margin;
}


QScrollBar::sub-line:horizontal:hover,
QScrollBar::sub-line:horizontal:on
{
    image: url(@icons/left_arrow.svg);
    width: 10px;
    height: 10px;
    subcontrol-position: left;
    subcontrol-origin: margin;
}

QScrollBar::up-arrow:horizontal,
QScrollBar::down-arrow:horizontal
{
    background: none;
}


QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal
{
    background: none;
}

QScrollBar:vertical
{
    background-color: transparent;
    width: 12px;
    margin: 12px 2px 12px 2px;
    border: 1px transparent;
    border-radius: 4px;
}

QScrollBar::handle:vertical
{
    background-color: @handle;
    min-height: 24px;
    border-radius: 4px;
}

QScrollBar::sub-line:vertical
{
    margin: 3px 0px 3px 0px;
    image: url(@icons/up_arrow_disabled.svg);
    height: 10px;
    width: 10px;
    subcontrol-position: top;
    subcontrol-origin: margin;
}

QScrollBar::add-line:vertical
{
    margin: 3px 0px 3px 0px;
    image: url(@icons/down_arrow_disabled.svg);
    height: 10px;
    width: 10px;
    subcontrol-position: bottom;
    subcontrol-origin: margin;
}

QScrollBar::sub-line:vertical:hover,
QScrollBar::sub-line:vertical:on
{

    image: url(@icons/up_arrow.svg);
    height: 10px;
    width: 10px;
    subcontrol-position: top;
    subcontrol-origin: margin;
}


QScrollBar::add-line:vertical:hover,
QScrollBar::add-line:vertical:on
{
    image: url(@icons/down_arrow.svg);
    height: 10px;
    width: 10px;
    subcontrol-position: bottom;
    subcontrol-origin: margin;
}

QScrollBar::up-arrow:vertical,
QScrollBar::down-arrow:vertical
{
    background: none;
}


QScrollBar::add-page:vertical, 
QScrollBar::sub-page:vertical
{
    background: none;
}

QTextEdit
{
    background-color: @surface;
    color: @text;
    border: 1px solid @border;
    margin: 0;
}

QPlainTextEdit
{
    background-color: @surface;;
    color: @text;
    border-radius: 2px;
    border: 1px solid @border;
}

QHeaderView::section
{
    background-color: @surface;
    color: @text-muted;
    padding-left: 4px;
    border: none;
}

QSizeGrip
{
    image: url(@icons/sizegrip.svg);
    width: 12px;
    height: 12px;
}

QMenu::separator
{
    height: 1px;
    background-color: @border;
    margin: 4px 8px;
}

QFrame
{
    border-radius: 4px;
    border: 1px solid @hover;
}

QFrame[frameShape="0"]
{
    border-radius: 2px;
    border: 1px transparent;
}

QStackedWidget
{
    border: 1px transparent;
}

QToolBar
{
    border: 1px transparent;
    background: 1px solid @bg;
    padding: 0px;
}

QToolBar::handle:horizontal
{
    image: url(@icons/hmovetoolbar.svg);
    width = 16px;
    height = 64px;
}

QToolBar::handle:vertical
{
    image: url(@icons/vmovetoolbar.svg);
    width = 54px;
    height = 10px;
}

QToolBar::separator:horizontal
{
    background-color: @hover;
    width: 1px;
    margin: 6px 4px;
}

QToolBar::separator:vertical
{
    background-color: @hover;
    height: 1px;
    margin: 8px 6px;
}

QPushButton
{
    color: @text;
    background-color: @surface;
    border: 1px solid @border;
    padding: 5px;
    border-radius: 4px;
    outline: none;
}

QPushButton:disabled
{
    background-color: @bg;
    border: 1px solid @hover;
    color: @text-disabled;
}

QPushButton:focus
{
    border: 1px solid @accent;
}

QPushButton:hover
{
    background-color: @hover;
    border: 1px solid @handle;
    color: @text-bright;
}

QPushButton:pressed
{
    background-color: @border;
}

QPushButton:checked,
QPushButton:checked:hover
{
    background-color: @selection;
    border: 1px solid @accent;
    color: @text-bright;
}

QPushButton:default
{
    background-color: @accent;
    border: 1px solid @accent;
    color: @on-accent;
}

QPushButton:default:hover
{
    background-color: @accent-hover;
    border: 1px solid @accent-hover;
}

QComboBox:hover,
QAbstractSpinBox:hover,
QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover,
QAbstractView:hover,
QTreeView:hover
{
    border: 1px solid @border-hover;
    color: @text;
}

QComboBox:focus,
QAbstractSpinBox:focus,
QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus
{
    border: 1px solid @accent;
}

QComboBox:on
{
    background-color: @hover;
    border: 1px solid @accent;
    selection-background-color: @selection;
}

QComboBox
{
    selection-background-color: @selection;
    background-color: @surface;
    border-style: solid;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 3px 6px;
}

QComboBox QAbstractItemView
{
    background-color: @surface;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 4px;
    outline: 0;
}

QComboBox::drop-down
{
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 14px;
    border: none;
}

QComboBox::down-arrow
{
    image: url(@icons/down_arrow_disabled.svg);
}

QComboBox::down-arrow:on,
QComboBox::down-arrow:hover,
QComboBox::down-arrow:focus
{
    image: url(@icons/down_arrow.svg);
}

QAbstractSpinBox
{
    padding: 3px 6px;
    border: 1px solid @border;
    background-color: @surface;
    color: @text;
    border-radius: 4px;
    min-width: 60px;
}

QAbstractSpinBox:up-button
{
    background-color: transparent;
    subcontrol-origin: border;
    subcontrol-position: center right;
}

QAbstractSpinBox:down-button
{
    background-color: transparent;
    subcontrol-origin: border;
    subcontrol-position: center left;
}

QAbstractSpinBox::up-arrow,
QAbstractSpinBox::up-arrow:disabled,
QAbstractSpinBox::up-arrow:off
{
    image: url(@icons/up_arrow_disabled.svg);
    width: 10px;
    height: 10px;
}

QAbstractSpinBox::up-arrow:hover
{
    image: url(@icons/up_arrow.svg);
}

QAbstractSpinBox::down-arrow,
QAbstractSpinBox::down-arrow:disabled,
QAbstractSpinBox::down-arrow:off
{
    image: url(@icons/down_arrow_disabled.svg);
    width: 10px;
    height: 10px;
}

QAbstractSpinBox::down-arrow:hover
{
    image: url(@icons/down_arrow.svg);
}

QLabel
{
    border: 0px solid black;
    margin-left: 2px;
    margin-right: 2px;
}

/* BORDERS */
QTabWidget::pane
{
    padding: 0px;
    padding-right: 3px;
    margin: 0px;
}

QTabWidget::pane:top
{
    border: 1px transparent;
    top: -1px;
}

QTabWidget::pane:bottom
{
    border: 1px transparent;
    bottom: -1px;
}

QTabWidget::pane:left
{
    border: 1px transparent;
    right: -1px;
}

QTabWidget::pane:right
{
    border: 1px transparent;
    left: -1px;
}


QTabBar
{
    qproperty-drawBase: 0;
    margin: 0px;
    padding: 0px;
    border-radius: 3px;
}

QTabBar:focus
{
    border: 0px transparent;
}

QTabBar::close-button
{
    image: url(@icons/close.svg);
    background: transparent;
}

QTabBar::close-button:hover
{
    image: url(@icons/close-hover.svg);
    width: 12px;
    height: 12px;
    background: transparent;
}

QTabBar::close-button:pressed
{
    image: url(@icons/close-pressed.svg);
    width: 12px;
    height: 12px;
    background: transparent;
}

QTabBar::tab
{
    color: @text-bright;
    background-color: transparent;
    padding: 6px 12px;
    border: none;
}

QTabBar::tab:!selected
{
    color: @text-muted;
    background-color: transparent;
}

QTabBar::tab:!selected:hover
{
    color: @text;
    background-color: @surface;
}

QTabBar::tab:disabled
{
    color: @text-disabled;
    background-color: transparent;
}

QTabBar::tab:top:selected    { border-bottom: 2px solid @accent; }
QTabBar::tab:bottom:selected { border-top: 2px solid @accent; }
QTabBar::tab:left:selected   { border-right: 2px solid @accent; }
QTabBar::tab:right:selected  { border-left: 2px solid @accent; }

QTabBar QToolButton::right-arrow:enabled
{
    image: url(@icons/right_arrow.svg);
}

QTabBar QToolButton::left-arrow:enabled
{
    image: url(@icons/left_arrow.svg);
}

QTabBar QToolButton::right-arrow:disabled
{
    image: url(@icons/right_arrow_disabled.svg);
}

QTabBar QToolButton::left-arrow:disabled
{
    image: url(@icons/left_arrow_disabled.svg);
}

QDockWidget
{
    background: @bg;
    border: 1px transparent;
    titlebar-close-icon: url(@icons/transparent.svg);
    titlebar-normal-icon: url(@icons/transparent.svg);
}

QDockWidget::title {
  background-color: @chrome;
  padding: 6px 8px;
  border: none;
  border-bottom: 1px solid @divider;
}

QDockWidget::close-button,
QDockWidget::float-button
{
    border: 1px solid transparent;
    border-radius: 4px;
    background: transparent;
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover
{
    background: @hover;
}

QDockWidget::float-button
{
    image: url(@icons/undock.svg);
}

QDockWidget::float-button:hover
{
    image: url(@icons/undock-hover.svg) ;
}

QDockWidget::close-button
{
    image: url(@icons/close.svg) ;
}

QDockWidget::close-button:hover
{
    image: url(@icons/close-hover.svg) ;
}

QDockWidget::close-button:pressed
{
    image: url(@icons/close-pressed.svg) ;
}

QTreeView,
QListView
{
    border: 1px solid @hover;
    border-radius: 4px;
    background-color: @bg;
}

QTreeView::branch:has-siblings:!adjoins-item
{
    image: url(@icons/stylesheet-vline.svg) 0;
}

QTreeView::branch:has-siblings:adjoins-item
{
    image: url(@icons/stylesheet-branch-more.svg) 0;
}

QTreeView::branch:!has-children:!has-siblings:adjoins-item
{
    image: url(@icons/stylesheet-branch-end.svg) 0;
}

QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings
{
    image: url(@icons/stylesheet-branch-end-closed.svg) 0;
    image: url(@icons/branch_closed.svg);
}

QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings
{
    image: url(@icons/stylesheet-branch-end-open.svg) 0;
    image: url(@icons/branch_open.svg);
}


QSlider::groove:horizontal
{
    border: none;
    height: 3px;
    background: @border;
    margin: 0px;
    border-radius: 1px;
}

QSlider::handle:horizontal
{
    background: @text;
    border: 2px solid @accent;
    width: 8px;
    height: 8px;
    margin: -5px 0;
    border-radius: 6px;
}

QSlider::groove:vertical
{
    border: 1px solid @bg;
    width: 4px;
    background: @handle;
    margin: 0px;
    border-radius: 3px;
}

QSlider::handle:vertical
{
    background: @bg;
    border: 1px solid @handle;
    width: 16px;
    height: 16px;
    margin: 0 -8px;
    border-radius: 9px;
}

QSlider::handle:horizontal:hover,
QSlider::handle:vertical:hover
{
    background: @text-bright;
    border-color: @accent-hover;
}

QSlider::sub-page:horizontal,
QSlider::add-page:vertical
{
    background: @accent;
    border-radius: 1px;
}

QSlider::add-page:horizontal,
QSlider::sub-page:vertical
{
    background: @border;
    border-radius: 1px;
}

QSlider::handle:disabled
{
    background: @bg;
    border: 1px solid @handle;
}

QSlider::groove:disabled
{
    background: @handle;
    border: 1px solid @handle;
}

QSlider::add-page:disabled,
QSlider::sub-page:disabled
{
    background: @handle;
    border-radius: 1px;
}

QToolButton#MaximizeButton,
QToolButton#MinimizeButton,
QToolButton#CloseButton {
    background-color: transparent;
    border: none;
    border-radius: 0px;
    margin: 0px;
    padding: 0px;
}

QToolButton#FileCloseButton {
    background-color: @danger;
    border: none;
    border-radius: 4px;
    margin: 0px;
    padding: 0px;
}

QToolButton#MinimizeButton:hover, QToolButton#MinimizeButton::menu-button:hover,
QToolButton#MaximizeButton:hover, QToolButton#MaximizeButton::menu-button:hover {
    background-color: @hover;
}

QToolButton#CloseButton:hover, QToolButton#CloseButton::menu-button:hover {
    background-color: @close-hover;
}

/* Linux: just a glyph; a soft circle appears on hover (see titlebar.cpp) */
QToolButton#MinimizeButton[compact="true"],
QToolButton#MaximizeButton[compact="true"],
QToolButton#CloseButton[compact="true"]
{
    background-color: transparent;
    border-radius: 14px;
}

QToolButton#MinimizeButton[compact="true"]:hover,
QToolButton#MaximizeButton[compact="true"]:hover,
QToolButton#CloseButton[compact="true"]:hover
{
    background-color: @hover;
}

QToolButton#MinimizeButton[compact="true"]:pressed,
QToolButton#MaximizeButton[compact="true"]:pressed,
QToolButton#CloseButton[compact="true"]:pressed
{
    background-color: @border-hover;
}

/* Window title bar (main window and dialogs) */
QWidget#TitleBar
{
    background-color: transparent;
}

QWidget#TitleBar QLabel
{
    background-color: transparent;
    color: @text-muted;
}

/* Only a real "close file" button when a file is open */
QToolButton#FileCloseButton:disabled {
    background-color: transparent;
}

QToolButton#FileCloseButton:hover, QToolButton#FileCloseButton::menu-button:hover {
    background-color: @danger-hover;
}

QToolButton
{
    background-color: transparent;
    border: 0px;
    border-radius: 6px;
    margin: 0px;
    padding: 1px 2px 2px 2px;
}

QToolButton[popupMode="1"] /* only for MenuButtonPopup */
{
    padding-right: 20px; /* make way for the popup button */
    border: 0px;
    border-radius: 6px;
    margin: 0px;
    padding-top: 0px;
    padding-left: 2px;
    padding-right: 2px;
    padding-bottom: 2px;
}

QToolButton[popupMode="2"] /* only for InstantPopup */
{
    padding-right: 10px; /* make way for the popup button */
    border: 0px;
    margin: 0px;
    padding-top: 0px;
    padding-left: 2px;
    padding-right: 2px;
    padding-bottom: 2px;
}

QToolButton:hover,
QToolButton:checked:hover,
QToolButton::menu-button:hover,
QToolButton::menu-button:checked:hover
{
    background-color: @hover;
}

QToolButton:checked, QToolButton:pressed,
QToolButton::menu-button:pressed {
    background-color: @border;
}


/* the subcontrols below are used only in the MenuButtonPopup mode */
QToolButton::menu-button
{
    border: 0px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    /* 16px width + 4px for border + no text = 20px allocated above */
    width: 16px;
    outline: none;
}

QToolButton::menu-arrow
{
    image: url(@icons/down_arrow.svg);
}

QToolButton::menu-arrow:open
{
    border: none;
}

QToolButton#ModeButton::menu-arrow
{
   /*image: url(@icons/mode_down_arrow.svg);*/
   image:none;
}

/* the subcontrol below is used only in the InstantPopup or DelayedPopup mode */
QToolButton::menu-indicator
{
    image: url(@icons/down_arrow.svg);
    top: -20px;
    left: 0px;
    width:8px;
    height:10px;
}

QToolButton{
    
}

QToolButton#ModeButton
{
    padding: 2px 4px;
}

QToolButton#ModeButton::menu-indicator
{
    image: url(@icons/down_arrow.svg);
    subcontrol-origin: padding;
    subcontrol-position: center right;
    top: 0px;
    left: 0px;
    width: 8px;
    height: 8px;
}
QToolButton#ModeButton::menu-indicator:hover
{
    top: 0px;
}

QPushButton::menu-indicator
{
    subcontrol-origin: padding;
    subcontrol-position: bottom right;
    left: 0px;
}

QTableView
{
    border: 1px transparent;
    gridline-color: @hover;
    background-color: @bg;
}


QTableView,
QHeaderView
{
    border-radius: 0px;
}

QTableView::item,
QListView::item,
QTreeView::item
{
    padding: 3px;
}

QTableView::item:hover,
QListView::item:hover,
QTreeView::item:hover
{
    background: @surface;
}

QTableView::item:pressed,
QListView::item:pressed,
QTreeView::item:pressed
{
    background: @selection;
    color: @text-bright;
}

QTableView::item:selected,
QTreeView::item:selected,
QListView::item:selected
{
    background: @selection;
    color: @text-bright;
}

QHeaderView
{
    border: 1px transparent;
    border-radius: 2px;
    margin: 0px;
    padding: 0px;
}

QHeaderView::section
{
    background-color: @surface;
    color: @text-muted;
    padding: 5px 6px;
    border: none;
    border-bottom: 1px solid @hover;
    border-radius: 0px;
    text-align: center;
}

QHeaderView::section::vertical::first,
QHeaderView::section::vertical::only-one
{
    border-top: 1px transparent;
}

QHeaderView::section::vertical
{
    border-top: transparent;
}

QHeaderView::section::horizontal::first,
QHeaderView::section::horizontal::only-one
{
    border-left: 1px transparent;
}

QHeaderView::section::horizontal
{
    background-color: @surface;
    border-right: 1px solid @hover;
}


QHeaderView::section:checked
{
    color: @text-bright;
    background-color: @selection;
}

 /* style the sort indicator */
QHeaderView::down-arrow
{
    image: url(@icons/down_arrow.svg);
}

QHeaderView::up-arrow
{
    image: url(@icons/up_arrow.svg);
}

QTableCornerButton::section
{
    background-color: @bg;
    border: 1px transparent;
    border-radius: 2px;
}

QToolBox
{
    padding: 3px;
    border: 1px transparent;
}

QToolBox:selected
{
    background-color: @bg;
    border-color: @accent;
}

QToolBox:hover
{
    border-color: @accent;
}

QStatusBar::item
{
    border: 0px transparent;
}

QFrame[height="3"],
QFrame[width="3"]
{
    background-color: @handle;
}

QAbstractScrollArea
{
    border-radius: 2px;
    border: 0px;
    background-color: @bg;
}

QSplitter::handle:horizontal,
QMainWindow::separator
{
    background-color: @divider;
    width: 3px;
    border: none;
}

QSplitter::handle:vertical
{
    background-color: @divider;
    height: 3px;
}

QSplitter::handle:hover,
QMainWindow::separator:hover
{
    background-color: @accent;
}


QProgressBar:horizontal
{
    background-color: @hover;
    border: none;
    border-radius: 3px;
    height: 5px;
    text-align: right;
    margin-top: 5px;
    margin-bottom: 5px;
    margin-right: 50px;
    padding: 1px;
}

QProgressBar::chunk:horizontal
{
    background-color: @accent;
    border: 1px transparent;
    border-radius: 3px;
}

QSpinBox,
QDoubleSpinBox
{
    padding-right: 0px;
    background-color: @surface;
    border-style: solid;
    border: 1px solid @border;
    border-radius: 4px;
    color: @text;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button
{
    subcontrol-origin: content;
    subcontrol-position: right top;

    width: 16px;
    border-width: 1px;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow
{
    image: url(@icons/up_arrow.svg);
    width: 9px;
    height: 6px;
}

QSpinBox::up-arrow:hover,
QSpinBox::up-arrow:pressed,
QDoubleSpinBox::up-arrow:hover,
QDoubleSpinBox::up-arrow:pressed
{
    image: url(@icons/up_arrow-hover.svg);
    width: 9px;
    height: 6px;
}

QSpinBox::up-arrow:disabled,
QSpinBox::up-arrow:off,
QDoubleSpinBox::up-arrow:disabled,
QDoubleSpinBox::up-arrow:off
{
   image: url(@icons/up_arrow_disabled.svg);
}

QSpinBox::down-button,
QDoubleSpinBox::down-button
{
    subcontrol-origin: content;
    subcontrol-position: right bottom;

    width: 16px;
    border-width: 1px;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow
{
    image: url(@icons/down_arrow.svg);
    width: 9px;
    height: 6px;
}

QSpinBox::down-arrow:hover,
QSpinBox::down-arrow:pressed,
QDoubleSpinBox::down-arrow:hover,
QDoubleSpinBox::down-arrow:pressed
{
    image: url(@icons/down_arrow-hover.svg);
    width: 9px;
    height: 6px;
}

QSpinBox::down-arrow:disabled,
QSpinBox::down-arrow:off,
QDoubleSpinBox::down-arrow:disabled,
QDoubleSpinBox::down-arrow:off
{
   image: url(@icons/down_arrow_disabled.svg);
}

QTextBrowser:hover
{
   border: 1px transparent;
}

QLineEdit#PathLine{
    color:@text;
}
QTextEdit#PathLine{
    color:@text;
}

/* ================================================================
 * Main top bar: compact, grouped, icon-beside-text
 * ================================================================ */
QToolBar#main_bar
{
    background-color: transparent;
    border: none;
    padding: 4px 2px 4px 6px;
    spacing: 0px;
}

QWidget#main_bar_row,
QToolBar#main_bar QToolBar   /* the groups, see topbarlayout.h */
{
    background-color: transparent;
    border: none;
    padding: 0px;
    spacing: 2px;
}

QToolBar QToolButton,
QToolBar QToolButton[popupMode="1"],
QToolBar QToolButton[popupMode="2"]
{
    border-radius: 6px;
    margin: 0px;
    padding: 4px 6px;
}

QToolBar QToolButton[popupMode="2"]
{
    padding-right: 18px;   /* room for the menu arrow */
}

QToolBar QToolButton::menu-indicator
{
    image: url(@icons/down_arrow.svg);
    subcontrol-origin: padding;
    subcontrol-position: center right;
    top: 0px;
    left: -5px;
    width: 8px;
    height: 8px;
}

QToolBar QToolButton#qt_toolbar_ext_button
{
    padding: 0px;
}

QToolBar QComboBox
{
    margin: 0px 2px;
    padding: 3px 2px 3px 4px;
    min-height: 20px;
}

QToolBar#main_bar QLabel
{
    background-color: transparent;
}

QLabel#SampleAtLabel
{
    color: @text-muted;
    margin: 0px 2px;
}


/* ================================================================
 * Activity bar: vertical strip at the right edge that switches the
 * side panels. Its items: ACTIVITY_BAR_LAYOUT in topbarlayout.h.
 * ================================================================ */
QToolBar#activity_bar
{
    background-color: transparent;
    border: none;
    padding: 4px 0px;
    spacing: 0px;
}

QToolBar#activity_bar QToolBar
{
    background-color: transparent;
    border: none;
    padding: 0px;
    spacing: 2px;
}

QToolBar#activity_bar QToolButton,
QToolBar#activity_bar QToolButton[popupMode="1"],
QToolBar#activity_bar QToolButton[popupMode="2"]
{
    border: none;
    border-left: 2px solid transparent;
    border-radius: 0px;
    margin: 0px;
    padding: 9px 10px 9px 8px;
}

QToolBar#activity_bar QToolButton:hover
{
    background-color: @hover;
}

/* the open panel */
QToolBar#activity_bar QToolButton:checked
{
    background-color: transparent;
    border-left-color: @accent;
}

QToolBar#activity_bar QToolButton:checked:hover
{
    background-color: @hover;
}

/* menu buttons (display settings) are not panels: no "open" marker */
QToolBar#activity_bar QToolButton[popupMode="2"],
QToolBar#activity_bar QToolButton[popupMode="2"]:checked
{
    border-left-color: transparent;
}

QToolBar#activity_bar QToolButton::menu-indicator
{
    image: none;
    width: 0px;
}

QToolBar#activity_bar QToolBar::separator:vertical
{
    background-color: @divider;
    height: 1px;
    margin: 6px 10px;
}


/* ================================================================
 * Status bar at the bottom (pv/ui/appstatusbar.cpp)
 * ================================================================ */
QStatusBar#app_status_bar
{
    background-color: transparent;
    border: none;
    color: @text-muted;
    min-height: 24px;
    padding: 0px 4px;
}

QStatusBar#app_status_bar::item
{
    border: none;
}

QStatusBar#app_status_bar QLabel
{
    background-color: transparent;
    color: @text-muted;
    padding: 0px 8px;
}

QStatusBar#app_status_bar QLabel#status_device
{
    color: @text;
}

QStatusBar#app_status_bar QLabel#status_state[working="true"]
{
    color: @accent-hover;
}


/* ================================================================
 * Cards: the waveform area and the side panels are rounded blocks
 * on the darker window background, separated by gaps.
 * ================================================================ */
QMainWindow#MainWindow
{
    background-color: transparent;
}

/* The whole window: rounded, with a thin outline (pv/mainframe.cpp).
   Title bar, toolbars and status bar are transparent on top of it. */
QFrame#window_frame
{
    background-color: @chrome;
    border: 1px solid @border;
    border-radius: 10px;
}

QFrame#window_frame[maximized="true"],
QFrame#window_frame[native="true"]
{
    border: none;
    border-radius: 0px;
}

QFrame#central_card
{
    background-color: @bg;
    border: 1px solid @divider;
    border-radius: 8px;
    padding: 2px;
    margin: 0px 0px 0px 6px;
}

QMainWindow#MainWindow::separator
{
    background-color: transparent;
    width: 6px;
    height: 6px;
}

QMainWindow#MainWindow::separator:hover
{
    background-color: @hover;
}

/* side panels, see pv/ui/panelcard.cpp */
QFrame#panel_card
{
    background-color: @bg;
    border: 1px solid @divider;
    border-radius: 8px;
    padding: 2px;
    margin-right: 4px;
}

QLabel#panel_card_header
{
    background-color: transparent;
    color: @text;
    font-weight: 600;
    padding: 6px 8px 8px 8px;
    border-bottom: 1px solid @divider;
}

/* File / Help menu buttons in the top bar: icon only, no arrow */
QToolBar QToolButton#file_menu_button,
QToolBar QToolButton#help_menu_button
{
    padding: 4px 6px;
}

QToolBar QToolButton#file_menu_button::menu-indicator,
QToolBar QToolButton#help_menu_button::menu-indicator
{
    image: none;
    width: 0px;
}

/* Dialogs and message boxes (pv/dialogs/dsdialog.cpp, dsmessagebox.cpp) */
QFrame#dialog_frame
{
    background-color: @bg;
    border: 1px solid @border;
    border-radius: 10px;
}

/* ---- Dialog buttons --------------------------------------------------- */

QDialogButtonBox QPushButton
{
    min-width: 72px;
    padding: 5px 12px;
}

/* Magnifier shown inside the search field of the search bar */
QPushButton#inline_search_icon,
QPushButton#inline_search_icon:disabled
{
    background-color: transparent;
    border: none;
}
